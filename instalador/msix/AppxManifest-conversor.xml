<?xml version="1.0" encoding="utf-8"?>
<!-- Manifesto do paquete MSIX do Conversor de archivos para IA, unha
     aplicación PROPIA na Store (non vai dentro do paquete do anonimizador).
     montar_msix.py substitúe {VERSION} (a de conversor.VERSION).
     A identidade (Name, Publisher, PublisherDisplayName) ten que ser a que dea
     Partner Center ao reservar o nome "Conversor de archivos para IA": se non
     coincide letra a letra, a Store rexeita o paquete. Publisher é o da conta
     (o mesmo có anonimizador); o Name de aquí é PROVISIONAL (vale para a
     copia de proba na VM) ata reservar o nome. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="JosLuisLpezFontn.ConversordearchivosparaIA"
    Publisher="CN=D4ECC9E2-BE4E-46B0-A68D-EF12B55919C3"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Conversor de archivos para IA</DisplayName>
    <PublisherDisplayName>José Luis López Fontán</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 19041 = Windows 10 2004: o primeiro que entende uap10:Parameters -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
    <Resource Language="gl-ES" />
  </Resources>

  <Applications>
    <!-- Coma o anonimizador: o Python do paquete co módulo de arranque
         (src/anonimizador/arranque_conversor.py), que atopa polo .pth que
         montar_msix.py deixa en site-packages. -->
    <Application Id="Conversor"
      Executable="runtime\python\pythonw.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:Parameters="-m anonimizador.arranque_conversor">
      <uap:VisualElements
        DisplayName="Conversor de archivos para IA"
        Description="Convierte documentos a Markdown en este ordenador, con o sin anonimizar, para pasarlos a una IA gastando menos tokens."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
